{
  "name": "@a2z/server",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "A2Z Service Desk API (Express + MongoDB). Runs TypeScript directly on Node.js 22.6+.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node scripts/check-node.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "import:browser": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/import-browser.ts",
    "account:password": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/seed-accounts.ts",
    "email:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-email.ts",
    "admin:reset": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/reset-admin.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3"
  }
}
