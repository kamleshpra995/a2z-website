# Copy to server/.env and fill in. Never commit server/.env.
# Use an Atlas database user with read/write access to this database only, and allow this host
# in Atlas Network Access.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/
MONGODB_DB=a2z-service-desk
PORT=4173
HOST=127.0.0.1

# First startup only; changing these later does not change an existing Admin password.
ADMIN_NAME=A2Z Admin
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-password

# Production: set NODE_ENV=production, COOKIE_SECURE=true (HTTPS), and TRUST_PROXY=1 when running
# behind exactly one trusted proxy (most hosting platforms).
# NODE_ENV=production
COOKIE_SECURE=false
TRUST_PROXY=0
# Persistent folder for ticket attachments (default: server/uploads). Back it up with MongoDB.
# UPLOAD_DIR=/var/data/a2z-uploads
# Built webapp to serve in production (default: ../webapp/dist).
# WEBAPP_DIST=/srv/a2z/webapp/dist

# Temporary, for `npm run account:password -w server` only. Remove after use.
# ACCOUNT_EMAIL=
# ACCOUNT_PASSWORD=

# Ticket emails (received / technician assigned / resolved / closed). Leave SMTP_PASS empty to turn
# them off. Zoho Mail: create an App Password (Zoho Mail → Settings → Security → App Passwords).
# Own-domain mailbox on Zoho India (accounts.zoho.in): smtppro.zoho.in. On zoho.com: smtppro.zoho.com.
# Check with: npm run email:test -w server -- you@example.com
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_USER=info@a2zpowersolution.in
SMTP_PASS=
MAIL_FROM=A2Z Power Solution <info@a2zpowersolution.in>
SUPPORT_EMAIL=info@a2zpowersolution.in
# Address of the portal used in email links.
PORTAL_URL=http://localhost:5173/portal/
